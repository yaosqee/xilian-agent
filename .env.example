# ── 必需 ──
DEEPSEEK_API_KEY=sk-你的deepseek-key
# DEEPSEEK_API_KEY_2=sk-你的备用deepseek-key

# ── 路由 / Agent 循环 ──
MODEL_ROUTING_V2=1
LOOP_V2=1
INTENT_ROUTER=1
WEATHER_INTENT_ROUTER=1
DEEPSEEK_DISABLE_THINKING=1

# ── 识图 ──
VISION_PROVIDER=deepseek
VISION_MODEL=deepseek-v4-flash-vision-exp
# 兼容旧方案时才需要：
# VISION_PROVIDER=mimo
# MIMO_API_KEY=sk-你的mimo-key

# ── 天气 ──
WEATHER_PROVIDER=auto
# QWEATHER_API_KEY=你的和风天气key

# ── 搜索 ──
# SEARCH_PROVIDER=deepseek
# ZHIPU_SEARCH_API_KEY=你的智谱key

# ── Embedding（可选；不填会降级）──
# EMBED_API_KEY=sk-你的硅基流动key
# EMBED_BASE_URL=https://api.siliconflow.cn/v1
# EMBED_MODEL=BAAI/bge-m3

# ── 服务 ──
# HTTP_PORT=8000
# BIND_HOST=127.0.0.1
# FRONTEND_DEV=0
# CORS_ORIGINS=
# XILIAN_HOME=